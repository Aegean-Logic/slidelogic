<?xml version="1.0" encoding="utf-8"?>
<!--
  SlideLogic MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build deckcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.deckcraft` owned by
  SlideLogic, and SlideLogic offered under "Open with" for .pptx/.potx/.ppsx (without taking over
  the user's default app for them).

  UpgradeCode and the component GUID below belong to SlideLogic alone (generated 2026-10-17;
  DeckCraft's are different), so installing SlideLogic never upgrades, replaces or removes
  DeckCraft. Fixed for SlideLogic forever (playbook §6); never change them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="SlideLogic"
      Manufacturer="Aegean Logic"
      Version="$(var.Version)"
      UpgradeCode="42930AEF-4C92-48C5-9809-E0F83112656E"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="SlideLogic presentations and slide shows" Manufacturer="Aegean Logic" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of SlideLogic is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DeckcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DeckcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.aegeanlogic.co.uk" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Aegean-Logic/slidelogic/releases" />
    <Property Id="ARPHELPLINK" Value="https://www.aegeanlogic.co.uk" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SlideLogic" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="SlideLogic" Level="1">
      <ComponentGroupRef Id="DeckcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DeckcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DeckcraftApp" Guid="F5DEECE8-77EF-471A-BD29-E33564E17FCD">
        <File Id="DeckcraftExe" Source="$(var.BinDir)\deckcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="SlideLogic"
              Description="SlideLogic presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DeckcraftIcon.ico" IconIndex="0" />
        </File>

        <!-- .deckcraft: SlideLogic's own format. -->
        <ProgId Id="SlideLogic.Presentation" Description="SlideLogic Presentation" Icon="DeckcraftExe" IconIndex="0">
          <Extension Id="deckcraft" ContentType="application/x-deckcraft">
            <Verb Id="open" Command="Open" TargetFile="DeckcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe" Name="FriendlyAppName" Value="SlideLogic" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\SupportedTypes" Name=".deckcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pptx\OpenWithProgids" Name="SlideLogic.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.potx\OpenWithProgids" Name="SlideLogic.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ppsx\OpenWithProgids" Name="SlideLogic.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\deckcraft.exe" Value="[#DeckcraftExe]" Type="string" />
      </Component>

      <Component Id="DeckcraftCli">
        <File Id="DeckcraftCliExe" Source="$(var.BinDir)\deckcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
